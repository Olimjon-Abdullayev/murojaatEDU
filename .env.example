# Obtain a NEW API key; never push .env to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional shared code for the entire demo. Required for a public AI-enabled demo.
DEMO_ACCESS_CODE=
# Set a strong unique specialist code before hosting. Local fallback: edu-local-2026
ADMIN_ACCESS_CODE=
AI_DAILY_LIMIT=50
PORT=3000
